@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-4">Para iniciar el turno de ventas, por favor ingrese el monto inicial de apertura de la caja registradora (Fondo de caja).</MudText>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudNumericField @bind-Value="initialAmount" Label="Monto Inicial (Efectivo)" Format="C2" Min="0" Required="true" RequiredError="Debe ingresar un monto" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@saving">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!success || saving)">
            @if (saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Abrir Turno
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public Guid CashRegisterId { get; set; }

    private MudForm form = null!;
    private bool success = false;
    private bool saving = false;
    
    private decimal initialAmount = 0;

    private async Task Submit()
    {
        await form.Validate();
        if (form.IsValid)
        {
            saving = true;
            try
            {
                var command = new { CashRegisterId, InitialAmount = initialAmount };
                var response = await Http.PostAsJsonAsync("api/v1/sales/sessions/open", command);
                
                if (response.IsSuccessStatusCode)
                {
                    var sessionId = await response.Content.ReadFromJsonAsync<Guid>();
                    Snackbar.Add("Turno de caja abierto exitosamente.", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(sessionId));
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Error al abrir la caja: {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add("Error de conexión: " + ex.Message, Severity.Error);
            }
            finally
            {
                saving = false;
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
