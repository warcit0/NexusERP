@using System.Net.Http.Json
@using NexusERP.WebDashboard.Models.Sales
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTextField @bind-Value="model.Name" Label="Nombre o Razón Social" Required="true" RequiredError="El nombre es requerido!" />
            <MudTextField @bind-Value="model.Identification" Label="Identificación" />
            <MudTextField @bind-Value="model.Email" Label="Correo Electrónico" />
            <MudTextField @bind-Value="model.Phone" Label="Teléfono" />
            <MudTextField @bind-Value="model.Address" Label="Dirección" Lines="2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!success || loading)">
            @if (loading)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Guardando</MudText>
            }
            else
            {
                <MudText>Guardar</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm form = null!;
    private bool success;
    private bool loading = false;
    private CreateCustomerCommand model = new();

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (form.IsValid)
        {
            loading = true;
            try
            {
                var response = await Http.PostAsJsonAsync("api/v1/sales/customers", model);
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Cliente creado con éxito", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Error: {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add("Error al guardar: " + ex.Message, Severity.Error);
            }
            finally
            {
                loading = false;
            }
        }
    }
}
