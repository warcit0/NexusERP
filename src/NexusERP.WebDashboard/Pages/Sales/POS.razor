@page "/sales/pos"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using NexusERP.WebDashboard.Models.Sales
@using NexusERP.WebDashboard.Models.Settings
@using NexusERP.WebDashboard.Models.Catalog
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize]

<MudText Typo="Typo.h5" Class="mb-4">Punto de Venta (POS)</MudText>

@if (loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (activeSession == null)
{
    <MudAlert Severity="Severity.Warning">No hay una sesión de caja abierta en este momento. Por favor, abre una sesión desde la pantalla de Cajas Registradoras antes de facturar.</MudAlert>
}
else
{
    <MudGrid>
        <!-- Productos a la Izquierda -->
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4" Style="height: 75vh; overflow-y: auto;">
                <MudTextField @bind-Value="searchString" Placeholder="Buscar producto por nombre o SKU..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mb-4" TextChanged="OnSearchChanged" Immediate="true"></MudTextField>
                
                <MudGrid>
                    @foreach (var p in filteredProducts)
                    {
                        <MudItem xs="6" sm="4" md="3">
                            <MudCard Elevation="2" Class="cursor-pointer" @onclick="() => AddToCart(p)">
                                <MudCardContent>
                                    <MudText Typo="Typo.body1"><b>@p.ProductName</b></MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@p.Sku</MudText>
                                    @if (!string.IsNullOrEmpty(p.Size) || !string.IsNullOrEmpty(p.Color))
                                    {
                                        <MudText Typo="Typo.caption" Class="d-block">@p.Size - @p.Color</MudText>
                                    }
                                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-2">@p.Price.ToString("C")</MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        </MudItem>

        <!-- Carrito a la Derecha -->
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 d-flex flex-column" Style="height: 75vh;">
                <MudText Typo="Typo.h6">Ticket de Venta</MudText>
                
                <MudSelect T="Guid?" Label="Cliente (Opcional)" @bind-Value="selectedCustomerId" Clearable="true" Class="mb-4">
                    @foreach (var c in customers)
                    {
                        <MudSelectItem T="Guid?" Value="@c.Id">@c.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudDivider Class="mb-2" />

                <div style="flex-grow: 1; overflow-y: auto;">
                    <MudList T="string">
                        @foreach (var item in cart)
                        {
                            <MudListItem T="string">
                                <div class="d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.body2"><b>@item.ProductName</b></MudText>
                                        <MudText Typo="Typo.caption">@item.Quantity x @item.UnitPrice.ToString("C")</MudText>
                                    </div>
                                    <div class="d-flex align-center">
                                        <MudText Typo="Typo.body2" Class="mr-2">@item.Total.ToString("C")</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => RemoveFromCart(item)" />
                                    </div>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                    @if (!cart.Any())
                    {
                        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mt-4">El carrito está vacío</MudText>
                    }
                </div>

                <MudDivider Class="my-2" />
                
                <div class="d-flex justify-space-between">
                    <MudText Typo="Typo.h6">Subtotal:</MudText>
                    <MudText Typo="Typo.h6">@cart.Sum(x => x.Subtotal).ToString("C")</MudText>
                </div>
                <div class="d-flex justify-space-between">
                    <MudText Typo="Typo.h6">Impuestos:</MudText>
                    <MudText Typo="Typo.h6">@cart.Sum(x => x.TaxTotal).ToString("C")</MudText>
                </div>
                <div class="d-flex justify-space-between mt-2">
                    <MudText Typo="Typo.h5" Color="Color.Primary"><b>TOTAL:</b></MudText>
                    <MudText Typo="Typo.h5" Color="Color.Primary"><b>@cart.Sum(x => x.Total).ToString("C")</b></MudText>
                </div>

                <MudButton Color="Color.Success" Variant="Variant.Filled" Size="Size.Large" Class="mt-4" Disabled="!cart.Any()" OnClick="OpenCheckout">
                    COBRAR
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private bool loading = true;
    private CashRegisterSessionDto? activeSession;
    private List<ProductVariantDto> allProducts = new();
    private List<ProductVariantDto> filteredProducts = new();
    private List<CustomerDto> customers = new();
    private Guid? selectedCustomerId;
    
    private List<SaleDetailModel> cart = new();
    private string searchString = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            // 1. Obtener la caja activa del usuario (para la sucursal actual)
            // Haremos una trampa temporal llamando al API de cajas y buscando una abierta
            // En un sistema real esto dependería del usuario logueado
            var branches = await Http.GetFromJsonAsync<List<BranchDto>>("api/v1/settings/branches") ?? new();
            var registers = await Http.GetFromJsonAsync<List<CashRegisterDto>>("api/v1/settings/cashregisters") ?? new();
            
            var openRegister = registers.FirstOrDefault(r => r.IsOpen); // Usar IsOpen que ahora viene del backend
            if (openRegister != null)
            {
                var sessionResponse = await Http.GetFromJsonAsync<CashRegisterSessionDto>($"api/v1/sales/sessions/active?cashRegisterId={openRegister.Id}");
                if (sessionResponse != null)
                {
                    activeSession = sessionResponse;
                }
            }
            
            // Cargar productos completos y extraer las variantes para el POS
            var products = await Http.GetFromJsonAsync<List<ProductDto>>("api/v1/catalog/products") ?? new();
            allProducts = products.SelectMany(p => p.Variants.Select(v => new ProductVariantDto 
            {
                Id = v.Id,
                ProductId = p.Id,
                ProductName = p.Name,
                Sku = v.Sku,
                Barcode = v.Barcode,
                Price = v.Price,
                Size = v.Size,
                Color = v.Color,
                TaxPercentage = p.TaxPercentage
            })).ToList();
            
            filteredProducts = allProducts;
            
            customers = await Http.GetFromJsonAsync<List<CustomerDto>>("api/v1/sales/customers") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error cargando POS: " + ex.Message, Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private void OnSearchChanged(string text)
    {
        searchString = text;
        if (string.IsNullOrWhiteSpace(searchString))
        {
            filteredProducts = allProducts;
        }
        else
        {
            filteredProducts = allProducts.Where(p => 
                p.ProductName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || 
                p.Sku.Contains(searchString, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private void AddToCart(ProductVariantDto p)
    {
        var existing = cart.FirstOrDefault(x => x.ProductVariantId == p.Id);
        if (existing != null)
        {
            existing.Quantity++;
        }
        else
        {
            cart.Add(new SaleDetailModel
            {
                ProductVariantId = p.Id,
                ProductName = p.ProductName,
                Sku = p.Sku,
                Quantity = 1,
                UnitPrice = p.Price,
                TaxPercentage = p.TaxPercentage
            });
        }
    }

    private void RemoveFromCart(SaleDetailModel item)
    {
        cart.Remove(item);
    }

    private async Task OpenCheckout()
    {
        if (activeSession == null) return;

        var parameters = new DialogParameters
        {
            { "Total", cart.Sum(x => x.Total) },
            { "HasCustomer", selectedCustomerId.HasValue }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<POSCheckoutDialog>("Cobrar", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is PaymentModel payment)
        {
            var command = new CreateSaleCommand
            {
                CashRegisterSessionId = activeSession.Id,
                BranchId = activeSession.BranchId,
                CustomerId = selectedCustomerId,
                Details = cart,
                Payments = new List<PaymentModel> { payment }
            };

            try
            {
                var response = await Http.PostAsJsonAsync("api/v1/sales", command);
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Venta registrada exitosamente", Severity.Success);
                    cart.Clear();
                    selectedCustomerId = null;
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Error al facturar: {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error de red: {ex.Message}", Severity.Error);
            }
        }
    }
}
