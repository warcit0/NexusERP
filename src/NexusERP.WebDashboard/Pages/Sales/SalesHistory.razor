@page "/sales/history"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using NexusERP.WebDashboard.Models.Sales
@using NexusERP.WebDashboard.Models.Settings
@inject HttpClient Http
@inject ISnackbar Snackbar
@attribute [Authorize]

<MudText Typo="Typo.h5" Class="mb-4">Historial de Ventas</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudSelect T="Guid?" Label="Filtrar por Sucursal" Value="selectedBranchId" ValueChanged="OnBranchChanged" Clearable="true">
        @foreach (var branch in branches)
        {
            <MudSelectItem T="Guid?" Value="@branch.Id">@branch.Name</MudSelectItem>
        }
    </MudSelect>
</MudPaper>

<MudPaper Class="pa-4">
    <MudTable Items="@sales" Loading="@loading" Hover="true" Breakpoint="Breakpoint.Sm" Striped="true">
        <HeaderContent>
            <MudTh>Fecha</MudTh>
            <MudTh>Recibo</MudTh>
            <MudTh>Cliente</MudTh>
            <MudTh Style="text-align: right">Total</MudTh>
            <MudTh>Estado</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Fecha">@context.Date.ToLocalTime().ToString("g")</MudTd>
            <MudTd DataLabel="Recibo">@context.ReceiptNumber</MudTd>
            <MudTd DataLabel="Cliente">@context.CustomerName</MudTd>
            <MudTd DataLabel="Total" Style="text-align: right">@context.Total.ToString("C")</MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Color="@(context.Status == "Completada" ? Color.Success : Color.Error)" Size="Size.Small">
                    @context.Status
                </MudChip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay ventas registradas.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>Cargando historial...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private List<SaleSummaryDto> sales = new();
    private List<BranchDto> branches = new();
    private bool loading = true;
    private Guid? selectedBranchId;

    protected override async Task OnInitializedAsync()
    {
        await LoadBranches();
        await LoadSales();
    }

    private async Task LoadBranches()
    {
        try
        {
            branches = await Http.GetFromJsonAsync<List<BranchDto>>("api/v1/settings/branches") ?? new();
        }
        catch (Exception) { }
    }

    private async Task LoadSales()
    {
        loading = true;
        try
        {
            string url = "api/v1/sales";
            if (selectedBranchId.HasValue)
            {
                url += $"?branchId={selectedBranchId.Value}";
            }
            sales = await Http.GetFromJsonAsync<List<SaleSummaryDto>>(url) ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar historial: " + ex.Message, Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnBranchChanged(Guid? branchId)
    {
        selectedBranchId = branchId;
        await LoadSales();
    }
}
