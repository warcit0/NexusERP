@using System.Net.Http.Json
@using NexusERP.WebDashboard.Models.Sales
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTextField @bind-Value="customer.Name" Label="Nombre Completo" Required="true" RequiredError="El nombre es requerido!" />
            <MudTextField @bind-Value="customer.Identification" Label="Cédula / Identificación" Required="true" />
            <MudTextField @bind-Value="customer.Email" Label="Correo Electrónico" />
            <MudTextField @bind-Value="customer.Phone" Label="Teléfono" />
            <MudTextField @bind-Value="customer.Address" Label="Dirección" Lines="2" />
            <MudNumericField @bind-Value="customer.CreditLimit" Label="Límite de Crédito" Min="0" Format="C2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@saving">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!success || saving)">
            @if (saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Guardar Cambios
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public CustomerDto Customer { get; set; } = null!;

    private MudForm form = null!;
    private bool success = false;
    private bool saving = false;
    
    private CustomerDto customer = new();

    protected override void OnInitialized()
    {
        // Clone the object to avoid mutating the table's state directly before saving
        customer = new CustomerDto
        {
            Id = Customer.Id,
            Name = Customer.Name,
            Identification = Customer.Identification,
            Email = Customer.Email,
            Phone = Customer.Phone,
            Address = Customer.Address,
            CreditLimit = Customer.CreditLimit
        };
    }

    private async Task Submit()
    {
        await form.Validate();
        if (form.IsValid)
        {
            saving = true;
            try
            {
                var response = await Http.PutAsJsonAsync($"api/v1/sales/customers/{customer.Id}", customer);
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Cliente actualizado exitosamente.", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Error al actualizar: {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error de red: {ex.Message}", Severity.Error);
            }
            finally
            {
                saving = false;
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
