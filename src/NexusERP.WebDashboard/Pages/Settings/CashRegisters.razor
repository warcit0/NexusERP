@page "/settings/cash-registers"
@using Microsoft.AspNetCore.Authorization
@using NexusERP.WebDashboard.Models.Catalog
@using NexusERP.WebDashboard.Pages.Sales
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize]

<MudText Typo="Typo.h5" Class="mb-4">Cajas Registradoras</MudText>

<MudPaper Class="pa-4">
    <MudToolBar>
        <MudSpacer />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenCreateDialog">Nueva Caja</MudButton>
    </MudToolBar>

    <MudTable Items="@cashRegisters" Loading="@loading" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>Sucursal</MudTh>
            <MudTh>Nombre</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Sesión</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Sucursal">@context.BranchName</MudTd>
            <MudTd DataLabel="Nombre">@context.Name</MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Error)">
                    @(context.IsActive ? "Activa" : "Inactiva")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Sesión">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsOpen ? Color.Warning : Color.Default)">
                    @(context.IsOpen ? "Abierta" : "Cerrada")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Acciones">
                @if (!context.IsOpen)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                               OnClick="() => OpenSession(context)">
                        Abrir Sesión
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                               OnClick="() => CloseSession(context)">
                        Cerrar Sesión
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay cajas registradas.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<CashRegisterDto> cashRegisters = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync() => await LoadCashRegisters();

    private async Task LoadCashRegisters()
    {
        loading = true; StateHasChanged();
        try { cashRegisters = await Http.GetFromJsonAsync<List<CashRegisterDto>>("api/v1/settings/cashregisters") ?? new(); }
        catch { Snackbar.Add("Error al cargar cajas", Severity.Error); }
        finally { loading = false; StateHasChanged(); }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CashRegisterCreateDialog>("Nueva Caja Registradora", options);
        var result = await dialog.Result;
        if (!result.Canceled) await LoadCashRegisters();
    }

    private async Task OpenSession(CashRegisterDto register)
    {
        var parameters = new DialogParameters
        {
            { "CashRegisterId", register.Id }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<OpenCashRegisterDialog>($"Abrir Turno: {register.Name}", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled) await LoadCashRegisters();
    }

    private async Task CloseSession(CashRegisterDto register)
    {
        // Get the active session ID first
        var sessionResponse = await Http.GetFromJsonAsync<CashRegisterSessionDto>($"api/v1/sales/sessions/active?cashRegisterId={register.Id}");
        if (sessionResponse == null)
        {
            Snackbar.Add("No se encontró una sesión activa para esta caja.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            { "SessionId", sessionResponse.Id }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CloseCashRegisterDialog>($"Arqueo y Cierre: {register.Name}", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled) await LoadCashRegisters();
    }

    public class CashRegisterDto
    {
        public Guid Id { get; set; }
        public Guid BranchId { get; set; }
        public string BranchName { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string MacAddress { get; set; } = string.Empty;
        public bool IsActive { get; set; }
        public bool IsOpen { get; set; }
    }
}
