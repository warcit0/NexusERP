@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using NexusERP.WebDashboard.Models
@using ApexCharts
@inject HttpClient Http
@attribute [Authorize]

<PageTitle>NexusERP | Dashboard</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Dashboard</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">@DateTime.Now.ToString("dddd, dd 'de' MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))</MudText>

@if (loading)
{
    <MudProgressLinear Color="MudBlazor.Color.Primary" Indeterminate="true" Class="mb-4" />
}

<!-- KPI Cards -->
<MudGrid>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Style="border-left: 4px solid #2563eb; border-radius: 12px;">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Ventas Hoy</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@summary.SalesToday.ToString("C")</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@summary.TransactionsToday transacciones</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="MudBlazor.Color.Primary" Style="font-size: 2.5rem; opacity: 0.3;" />
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Style="border-left: 4px solid #16a34a; border-radius: 12px;">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">CxC Pendiente</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@summary.TotalReceivablesPending.ToString("C")</MudText>
                    @if (summary.OverdueReceivables > 0)
                    {
                        <MudChip T="string" Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Small">@summary.OverdueReceivables vencidas</MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Sin vencimientos</MudText>
                    }
                </div>
                <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Color="MudBlazor.Color.Success" Style="font-size: 2.5rem; opacity: 0.3;" />
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Style="border-left: 4px solid #dc2626; border-radius: 12px;">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">CxP Pendiente</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@summary.TotalPayablesPending.ToString("C")</MudText>
                    @if (summary.OverduePayables > 0)
                    {
                        <MudChip T="string" Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Small">@summary.OverduePayables vencidas</MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Al día</MudText>
                    }
                </div>
                <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Color="MudBlazor.Color.Error" Style="font-size: 2.5rem; opacity: 0.3;" />
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Style="@($"border-left: 4px solid {(summary.CriticalStockItems > 0 ? "#f59e0b" : "#7c3aed")}; border-radius: 12px;")">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Stock Crítico</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@summary.CriticalStockItems</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">productos bajo mínimo</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="@(summary.CriticalStockItems > 0 ? MudBlazor.Color.Warning : MudBlazor.Color.Tertiary)" Style="font-size: 2.5rem; opacity: 0.3;" />
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- Gráfico de ventas últimos 7 días -->
<MudGrid Class="mt-6">
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4" Style="border-radius: 12px;">
            <MudText Typo="Typo.h6" Class="mb-4">Ventas — Últimos 7 Días</MudText>
            @if (summary.Last7DaysSales.Any())
            {
                <ApexChart TItem="DailySalePoint" Options="chartOptions">
                    <ApexPointSeries TItem="DailySalePoint"
                                     Items="chartData"
                                     Name="Ingresos"
                                     SeriesType="SeriesType.Area"
                                     XValue="@(e => e.Label)"
                                     YAggregate="@(e => e.Sum(x => x.Total))" />
                </ApexChart>
            }
            else
            {
                <MudAlert Severity="Severity.Info">No hay ventas registradas en los últimos 7 días.</MudAlert>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Style="border-radius: 12px; height: 100%;">
            <MudText Typo="Typo.h6" Class="mb-4">Resumen Semanal</MudText>
            <MudList T="string" Dense="true">
                @foreach (var day in summary.Last7DaysSales)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.CalendarToday">
                        <div class="d-flex justify-space-between" style="width:100%">
                            <MudText Typo="Typo.body2">@day.Label</MudText>
                            <MudText Typo="Typo.body2" Class="font-weight-bold">@day.Total.ToString("C")</MudText>
                        </div>
                    </MudListItem>
                }
            </MudList>
            <MudDivider Class="my-2" />
            <div class="d-flex justify-space-between pa-2">
                <MudText Typo="Typo.subtitle2">Total 7 días</MudText>
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="MudBlazor.Color.Primary">
                    @summary.Last7DaysSales.Sum(x => x.Total).ToString("C")
                </MudText>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private DashboardSummaryDto summary = new();
    private bool loading = true;
    private List<DailySalePoint> chartData = new();
    private ApexChartOptions<DailySalePoint> chartOptions = new();

    protected override async Task OnInitializedAsync()
    {
        chartOptions = new ApexChartOptions<DailySalePoint>
        {
            Chart = new ApexCharts.Chart { Height = 250, Toolbar = new Toolbar { Show = false } },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = new List<double> { 3 } },
            Fill = new Fill { Opacity = new List<double> { 0.15 } },
            Xaxis = new XAxis { Labels = new XAxisLabels { Style = new AxisLabelStyle { FontSize = "11px" } } },
            Yaxis = new List<YAxis> { new YAxis { Labels = new YAxisLabels { Formatter = "function(val) { return '$' + val.toLocaleString(); }" } } }
        };

        loading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<DashboardSummaryDto>("api/reports/dashboard");
            if (result != null)
            {
                summary = result;
                chartData = result.Last7DaysSales
                    .Select(d => new DailySalePoint { Label = d.Label, Total = d.Total })
                    .ToList();
            }
        }
        catch
        {
            // Si falla, el dashboard queda con valores en 0 (mejor que mostrar error)
        }
        finally
        {
            loading = false;
        }
    }

    public class DashboardSummaryDto
    {
        public decimal SalesToday { get; set; }
        public int TransactionsToday { get; set; }
        public decimal TotalReceivablesPending { get; set; }
        public int OverdueReceivables { get; set; }
        public decimal TotalPayablesPending { get; set; }
        public int OverduePayables { get; set; }
        public int CriticalStockItems { get; set; }
        public List<DailySaleDto> Last7DaysSales { get; set; } = new();
    }

    public class DailySaleDto
    {
        public string Label { get; set; } = string.Empty;
        public decimal Total { get; set; }
        public int Count { get; set; }
    }

    public class DailySalePoint
    {
        public string Label { get; set; } = string.Empty;
        public decimal Total { get; set; }
    }
}
