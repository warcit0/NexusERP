@page "/purchases/orders"
@using NexusERP.WebDashboard.Models
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
<MudText Typo="Typo.h5" Class="mb-4">Órdenes de Compra</MudText>

<MudTable Items="@orders" Dense="true" Hover="true" Loading="@loading">
    <ToolBarContent>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenNewOrderDialog">Nueva Orden</MudButton>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Número</MudTh>
        <MudTh>Proveedor</MudTh>
        <MudTh>Fecha</MudTh>
        <MudTh>Total</MudTh>
        <MudTh>Estado</MudTh>
        <MudTh>Acciones</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Número">@context.OrderNumber</MudTd>
        <MudTd DataLabel="Proveedor">@context.SupplierName</MudTd>
        <MudTd DataLabel="Fecha">@context.OrderDate.ToString("dd/MM/yyyy")</MudTd>
        <MudTd DataLabel="Total">@context.TotalAmount.ToString("C")</MudTd>
        <MudTd DataLabel="Estado">
            <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
        </MudTd>
        <MudTd>
            @if (context.Status == "Sent" || context.Status == "PartiallyReceived")
            {
                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Success" Size="Size.Small" OnClick="@(() => OpenReceiveDialog(context))">Recibir</MudButton>
            }
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<PurchaseOrderDto> orders = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        loading = true;
        try
        {
            var response = await Http.GetFromJsonAsync<List<PurchaseOrderDto>>("api/purchases/orders");
            if (response != null)
                orders = response;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar órdenes: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenNewOrderDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<PurchaseOrderCreateDialog>("Crear Orden de Compra", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadOrders();
        }
    }

    private async Task OpenReceiveDialog(PurchaseOrderDto order)
    {
        var parameters = new DialogParameters<ReceivePurchaseOrderDialog>
        {
            { x => x.OrderId, order.Id },
            { x => x.OrderNumber, order.OrderNumber }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ReceivePurchaseOrderDialog>($"Recibir Orden {order.OrderNumber}", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadOrders();
        }
    }

    private MudBlazor.Color GetStatusColor(string status)
    {
        return status switch
        {
            "Draft" => MudBlazor.Color.Default,
            "Sent" => MudBlazor.Color.Primary,
            "PartiallyReceived" => MudBlazor.Color.Warning,
            "Received" => MudBlazor.Color.Success,
            "Cancelled" => MudBlazor.Color.Error,
            _ => MudBlazor.Color.Default
        };
    }
}
