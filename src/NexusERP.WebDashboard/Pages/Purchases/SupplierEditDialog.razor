@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTextField @bind-Value="supplier.Name" Label="Razón Social / Nombre" Required="true" RequiredError="El nombre es requerido" />
            <MudTextField @bind-Value="supplier.TaxId" Label="Cédula Jurídica / RFC / Tax ID" Required="true" />
            <MudTextField @bind-Value="supplier.Email" Label="Correo Electrónico" />
            <MudTextField @bind-Value="supplier.Phone" Label="Teléfono" />
            <MudTextField @bind-Value="supplier.Address" Label="Dirección" Lines="2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@saving">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!success || saving)">
            @if (saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Guardar Cambios
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public Suppliers.SupplierDto Supplier { get; set; } = null!;

    private MudForm form = null!;
    private bool success = false;
    private bool saving = false;
    
    private Suppliers.SupplierDto supplier = new();

    protected override void OnInitialized()
    {
        supplier = new Suppliers.SupplierDto
        {
            Id = Supplier.Id,
            Name = Supplier.Name,
            TaxId = Supplier.TaxId,
            Email = Supplier.Email,
            Phone = Supplier.Phone,
            Address = Supplier.Address
        };
    }

    private async Task Submit()
    {
        await form.Validate();
        if (form.IsValid)
        {
            saving = true;
            try
            {
                var payload = new { supplier.Id, supplier.Name, supplier.TaxId, supplier.Email, supplier.Phone, supplier.Address };
                var response = await Http.PutAsJsonAsync($"api/purchases/suppliers/{supplier.Id}", payload);
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Proveedor actualizado exitosamente.", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Error al actualizar proveedor: {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error de red: {ex.Message}", Severity.Error);
            }
            finally
            {
                saving = false;
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
