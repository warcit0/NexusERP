@page "/reports"
@using NexusERP.WebDashboard.Models
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudText Typo="Typo.h4" Class="mb-4">Reportes</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h6">Filtros de Ventas</MudText>
    <MudGrid Class="mt-2">
        <MudItem xs="12" md="4">
            <MudDatePicker Label="Fecha Inicio" @bind-Date="startDate" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudDatePicker Label="Fecha Fin" @bind-Date="endDate" />
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadReport" Class="mr-2">Generar</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="ExportToExcel" StartIcon="@Icons.Custom.FileFormats.FileExcel">Exportar Excel</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (salesData != null && salesData.Any())
{
    <MudTable Items="salesData" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Fecha</MudTh>
            <MudTh>Sucursal</MudTh>
            <MudTh>Cant. Ventas</MudTh>
            <MudTh>Ingresos Totales</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Fecha">@context.Date.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Sucursal">@context.BranchName</MudTd>
            <MudTd DataLabel="Cant. Ventas">@context.TotalSales</MudTd>
            <MudTd DataLabel="Ingresos Totales">@context.TotalRevenue.ToString("C")</MudTd>
        </RowTemplate>
    </MudTable>
}
else
{
    <MudAlert Severity="Severity.Info">No hay datos para las fechas seleccionadas.</MudAlert>
}

@code {
    private DateTime? startDate = DateTime.Today.AddDays(-30);
    private DateTime? endDate = DateTime.Today;
    private List<SalesReportItemDto> salesData = new();
    private bool loading = false;

    private async Task LoadReport()
    {
        if (startDate == null || endDate == null)
        {
            Snackbar.Add("Seleccione rango de fechas", Severity.Warning);
            return;
        }

        loading = true;
        try
        {
            var url = $"api/reports/sales?startDate={startDate.Value:yyyy-MM-dd}&endDate={endDate.Value:yyyy-MM-dd}";
            var result = await Http.GetFromJsonAsync<List<SalesReportItemDto>>(url);
            if (result != null)
            {
                salesData = result;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ExportToExcel()
    {
        if (startDate == null || endDate == null) return;

        var url = $"api/reports/sales/export/excel?startDate={startDate.Value:yyyy-MM-dd}&endDate={endDate.Value:yyyy-MM-dd}";
        
        // Forma sencilla de descargar el archivo generado
        await JS.InvokeVoidAsync("window.open", url, "_blank");
    }
}
