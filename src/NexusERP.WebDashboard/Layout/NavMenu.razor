<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
    
    <AuthorizeView Roles="SuperAdmin">
        <Authorized>
            <MudNavGroup Title="Plataforma" Icon="@Icons.Material.Filled.Settings" Expanded="true">
                <MudNavLink Href="/platform/tenants" Icon="@Icons.Material.Filled.Business">Empresas (Tenants)</MudNavLink>
                <MudNavLink Href="/platform/plans" Icon="@Icons.Material.Filled.CardMembership">Planes</MudNavLink>
                <MudNavLink Href="/platform/licenses" Icon="@Icons.Material.Filled.Key">Licencias</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="TenantAdmin">
        <Authorized>
            <MudNavGroup Title="Administración" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="true">
                <MudNavLink Href="/catalog/categories" Icon="@Icons.Material.Filled.Category">Categorías</MudNavLink>
                <MudNavLink Href="/catalog/brands" Icon="@Icons.Material.Filled.LocalOffer">Marcas</MudNavLink>
                <MudNavLink Href="/catalog/taxes" Icon="@Icons.Material.Filled.ReceiptLong">Impuestos</MudNavLink>
            </MudNavGroup>
            
            <MudNavGroup Title="Configuración" Icon="@Icons.Material.Filled.Settings" Expanded="true">
                <MudNavLink Href="/settings/branches" Icon="@Icons.Material.Filled.Store">Sucursales</MudNavLink>
                <MudNavLink Href="/settings/cash-registers" Icon="@Icons.Material.Filled.PointOfSale">Cajas Registradoras</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <MudNavGroup Title="Ventas / POS" Icon="@Icons.Material.Filled.PointOfSale" Expanded="true">
        <MudNavLink Href="/sales/pos" Icon="@Icons.Material.Filled.ShoppingCartCheckout">Punto de Venta</MudNavLink>
        <MudNavLink Href="/sales/history" Icon="@Icons.Material.Filled.ReceiptLong">Historial de Ventas</MudNavLink>
        <MudNavLink Href="/sales/customers" Icon="@Icons.Material.Filled.People">Clientes</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Inventario" Icon="@Icons.Material.Filled.Inventory" Expanded="true">
        <MudNavLink Href="/inventory/stock" Icon="@Icons.Material.Filled.Warehouse">Kardex y Existencias</MudNavLink>
        <MudNavLink Href="/catalog/products" Icon="@Icons.Material.Filled.Category">Productos</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Compras" Icon="@Icons.Material.Filled.LocalShipping" Expanded="true">
        <MudNavLink Href="/purchases/suppliers" Icon="@Icons.Material.Filled.Business">Proveedores</MudNavLink>
        <MudNavLink Href="/purchases/orders" Icon="@Icons.Material.Filled.Receipt">Órdenes de Compra</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Finanzas" Icon="@Icons.Material.Filled.AccountBalance" Expanded="true">
        <MudNavLink Href="/finance/accounts-receivable" Icon="@Icons.Material.Filled.ArrowDownward">Cuentas por Cobrar</MudNavLink>
        <MudNavLink Href="/finance/accounts-payable" Icon="@Icons.Material.Filled.ArrowUpward">Cuentas por Pagar</MudNavLink>
    </MudNavGroup>

    <MudNavLink Href="/reports" Icon="@Icons.Material.Filled.BarChart" Match="NavLinkMatch.Prefix">Reportes y BI</MudNavLink>
</MudNavMenu>
